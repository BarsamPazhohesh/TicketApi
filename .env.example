# Application Mode (debug | release | test)
# In debug mode: Captcha answer returned in JSON response, verbose errors with stack trace
# In release mode: Captcha answer stripped, errors sanitized for production
GIN_MODE=release

# Authentication Secret (Required)
# 256-bit+ secure random string used for signing JWT tokens (Auth, Captcha, OneTimeToken)
JWT_SECRET=replace_with_strong_random_secret_at_least_32_chars

# MongoDB (Required when mongo.enable is true)
MONGODB_URI=mongodb://root:example@localhost:27017
MONGODB_DB=ticket_db

# Redis (Required when redis.enable is true and Redis requires auth)
REDIS_PASSWORD=

# MinIO / S3 Storage (Required when minio.enable is true)
ACCESS_KEY_MINIO=minioadmin
SECRET_KEY_MINIO=minioadmin
